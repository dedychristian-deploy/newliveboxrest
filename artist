' ==========================================================
' ACTION / KEYFRAME 1
' APPLY EDITED LAYOUT
' ==========================================================



' ==========================================================
' APPLY EDITED LAYOUT
' ==========================================================

sub apply_layout(boxType as Integer, boxData as String)

    dim items as Array[String]
    dim pair as Array[String]

    dim i as Integer

    dim boxNames as Array[String]
    dim targetIndexes as Array[Integer]

    println "===== APPLY LAYOUT ====="
    println "BOX TYPE = " & CStr(boxType)
    println "BOX DATA = " & boxData

    ' ------------------------------------------------------
    ' Parse:
    '
    ' BOX_01:0,BOX_02:2
    ' ------------------------------------------------------

    boxData.Split(",", items)

    for i = 0 to items.Size - 1

        pair.Clear()

        items[i].Split(":", pair)

        if pair.Size = 2 then

            boxNames.Push(pair[0])
            targetIndexes.Push(CInt(pair[1]))

        end if

    next


    ' ------------------------------------------------------
    ' Apply reorder
    ' dari target terbesar ke terkecil
    ' ------------------------------------------------------

    for i = boxNames.Size - 1 to 0 step -1

        println "MOVE " & boxNames[i] & " -> " & CStr(targetIndexes[i])

        set_index(boxType,boxNames[i],targetIndexes[i])

    next


    ' ------------------------------------------------------
    ' Set layout edited
    ' ------------------------------------------------------

    Scene.FindContainer("BOX_LAYOUTS").ScriptPluginInstance.SetParameterInt("idxLayout", boxType)

    Scene.FindContainer("BOX_LAYOUTS").ScriptPluginInstance.Script.Execute2()

    Scene.UpdateSceneTree()


    println "===== EDITED FINAL ====="

    print_order(boxType)

end sub


' ==========================================================
' MOVE BOX KE TARGET INDEX
' ==========================================================

sub set_index(boxType as Integer, boxName as String, targetIndex as Integer)

    dim c as Container
    dim box as Container
    dim target as Container

    dim currentIndex as Integer


    c = Scene.FindContainer("BOX_LAYOUTS").GetChildContainerByIndex(boxType)

    if not c.Valid then

        println "INVALID LAYOUT INDEX = " & CStr(boxType)

        exit sub

    end if


    box = c.FindSubContainer(boxName)

    if not box.Valid then

        println "BOX NOT FOUND = " & boxName

        exit sub

    end if


    box.Active = true

    currentIndex = box.GetLocalIndex()


    println "SET INDEX: " & boxName & " " & CStr(currentIndex) & " -> " & CStr(targetIndex)


    if currentIndex = targetIndex then
        exit sub
    end if


    target = c.GetChildContainerByIndex(targetIndex)

    if not target.Valid then

        println "INVALID TARGET INDEX = " & CStr(targetIndex)

        exit sub

    end if


    if currentIndex > targetIndex then

        box.MoveTo(target, TL_PREVIOUS)

    else

        box.MoveTo(target, TL_NEXT)

    end if

end sub


' ==========================================================
' RESET ORDER
'
' hasil:
' BOX_01
' BOX_02
' BOX_03
' ...
' BOX_10
' ==========================================================

sub reset_reorder(boxType as Integer)

    dim c as Container
    dim box as Container
    dim target as Container

    dim i as Integer
    dim boxName as String


    println "===== RESET REORDER ====="
    println "BOX TYPE = " & CStr(boxType)


    c = Scene.FindContainer("BOX_LAYOUTS").GetChildContainerByIndex(boxType)

    if not c.Valid then

        println "INVALID LAYOUT INDEX = " & CStr(boxType)

        exit sub

    end if


    ' ------------------------------------------------------
    ' Susun BOX_10 ... BOX_01
    ' masing-masing dipindah ke depan
    '
    ' hasil akhirnya:
    ' BOX_01
    ' BOX_02
    ' ...
    ' BOX_10
    ' ------------------------------------------------------

    for i = 9 to 0 step -1

        if i < 9 then

            boxName = "BOX_0" & CStr(i + 1)

        else

            boxName = "BOX_10"

        end if


        box = c.FindSubContainer(boxName)


        if box.Valid then

            target = c.GetChildContainerByIndex(0)

            if box <> target then

                box.MoveTo(target, TL_PREVIOUS)

            end if

        end if

    next


    Scene.UpdateSceneTree()

end sub


' ==========================================================
' PRINT ORDER
' ==========================================================

sub print_order(boxType as Integer)

    dim c as Container
    dim i as Integer


    c = Scene.FindContainer("BOX_LAYOUTS").GetChildContainerByIndex(boxType)

    if not c.Valid then

        println "INVALID LAYOUT INDEX = " & CStr(boxType)

        exit sub

    end if


    println "===== ORDER ====="


    for i = 0 to c.ChildContainerCount - 1

        println CStr(i) & " = " & c.GetChildContainerByIndex(i).Name

    next

end sub


' ==========================================================
' OPTIONAL GET BOXES
' ==========================================================

sub getboxes(data as String)

    dim bundle as Array[String]
    dim items as Array[String]
    dim pair as Array[String]

    dim boxType as Integer
    dim i as Integer


    data.Split("|", bundle)


    if bundle.Size <> 2 then
        exit sub
    end if


    boxType = CInt(bundle[0])

    bundle[1].Split(",", items)


    println "BOX TYPE = " & CStr(boxType)


    for i = 0 to items.Size - 1

        pair.Clear()

        items[i].Split(":", pair)


        if pair.Size = 2 then

            println "BOX = " & pair[0]
            println "INPUT = " & pair[1]

        end if

    next

end sub


