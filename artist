' ==========================================================
' HTML EDITED
' HANYA SIMPAN DATA
'
' contoh:
' 1|BOX_01:0,BOX_02:2
' ==========================================================

sub msg_layout_edited(dataLayout as String)

    a = dataLayout

    println "===== HTML EDITED RECEIVED ====="
    println "A SAVED = " & a

end sub

sub exec_msg_layout_edited()

    dim bundle as Array[String]
    dim boxType as Integer
    dim boxData as String

    ' Kalau tidak ada edited data dari HTML, jangan lakukan apa-apa
    if a = "" then

        println "===== NO EDITED DATA - SKIP ====="
        exit sub

    end if

    println "===== EXEC EDITED ====="
    println "DATA = " & a

    a.Split("|", bundle)

    if bundle.Size <> 2 then

        println "INVALID EDITED DATA"
        exit sub

    end if

    boxType = CInt(bundle[0])
    boxData = bundle[1]

    apply_layout(boxType, boxData)

    ' Setelah dipakai, kosongkan
    a = ""

end sub

